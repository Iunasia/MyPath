# For running the backend WITHOUT Docker (npm run dev in backend/).
# Copy to backend/.env and point DATABASE_URL at your local Postgres.
#   cp .env.example .env
# When running under Docker Compose, ignore this file — the root .env
# and docker-compose.dev.yml supply these instead.

DATABASE_URL=postgres://mypath:mypath_dev_password@localhost:5432/mypath

PORT=5000
NODE_ENV=development
SESSION_SECRET=mypath-dev-secret
FRONTEND_URL=http://localhost:3000

# Admin account created by `npm run seed` if the email isn't registered yet.
# Changing the password later does NOT update an existing account.
SEED_ADMIN_EMAIL=admin@domner.edu.kh
SEED_ADMIN_PASSWORD=admin123

# Optional — Telegram alert to the review team on each verification request.
# Disabled unless both are set. See the root .env.example for setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Google sign-in is disabled when these are blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Optional — not read by any running code yet; reserved for the planned
# live re-check of submitted links.
SAFE_BROWSING_API_KEY=

# Email — HTTP API (works on UpCloud; no SMTP ports needed)
# Primary: Brevo (300 free emails/day) → https://app.brevo.com
#   Settings → SMTP & API → API Keys → Create Key
BREVO_API_KEY=
# Fallback: MailerSend (3,000 free emails/month) → https://app.mailersend.com
#   Email → Domains → Add domner.app → get API Token
MAILERSEND_API_KEY=
# Sender — must be a verified address/domain in both dashboards
EMAIL_FROM=Domner Team <noreply@domner.app>

# Optional — where verification screenshots are stored.
# Blank: written to ./uploads (or UPLOAD_DIR). On Vercel, which has no disk,
# screenshot uploads are refused until these are set; link-only requests work.
# Cloudflare R2: R2 → Create bucket (keep it private) → Manage API tokens →
# "Object Read & Write" for that bucket. Endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 uses "auto"; AWS S3 needs the bucket's region.
S3_REGION=auto
UPLOAD_DIR=

# Guards GET /verification-requests/attachments/purge, which Vercel Cron calls
# daily to delete screenshots 90 days after their request was answered.
# Any long random string; Vercel sends it automatically once set in the project.
CRON_SECRET=
