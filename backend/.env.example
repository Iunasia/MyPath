# For running the backend WITHOUT Docker (npm run dev in backend/).
# Copy to backend/.env and point DATABASE_URL at your local Postgres.
#   cp .env.example .env
# When running under Docker Compose, ignore this file — the root .env
# and docker-compose.dev.yml supply these instead.

DATABASE_URL=postgres://mypath:mypath_dev_password@localhost:5432/mypath

PORT=5000
NODE_ENV=development
SESSION_SECRET=mypath-dev-secret
FRONTEND_URL=http://localhost:3000

# Admin account created by `npm run seed` if the email isn't registered yet.
# Changing the password later does NOT update an existing account.
SEED_ADMIN_EMAIL=admin@domner.edu.kh
SEED_ADMIN_PASSWORD=admin123

# Optional — Telegram alert to the review team on each verification request.
# Disabled unless both are set. See the root .env.example for setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Google sign-in is disabled when these are blank.
# GOOGLE_CALLBACK_URL must be this API's own origin, NOT the frontend's: Google
# redirects the browser straight to the Express route, which then forwards on
# to FRONTEND_URL. Whatever value you set here has to be registered verbatim as
# an Authorized redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Optional — not read by any running code yet; reserved for the planned
# live re-check of submitted links.
SAFE_BROWSING_API_KEY=

# --- Deploying to Vercel --------------------------------------------------
# Set these in the Vercel project's Environment Variables instead of a file.
# NODE_ENV=production is what switches the session cookie to SameSite=None
# and moves sessions into Postgres, so the deploy will not stay logged in
# without it.
#
#   NODE_ENV=production
#   DATABASE_URL=<your provider's POOLED connection string>
#   SESSION_SECRET=<long random string, not the dev default>
#   FRONTEND_URL=https://<frontend>.vercel.app          # no trailing slash
#   GOOGLE_CALLBACK_URL=https://<backend>.vercel.app/auth/google/callback
#
# FRONTEND_URL is both the CORS allow-list and the post-login redirect target,
# so a trailing slash or an http:// scheme will break sign-in.
