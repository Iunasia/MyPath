# Production environment configuration for UpCloud deployment
# Copy this file to .env on the production VM before starting containers:
#   cp .env.prod.example .env

# --- Managed PostgreSQL on UpCloud -------------------------------------------
# Replace with your UpCloud Managed PostgreSQL connection string (include sslmode=require)
DATABASE_URL=postgres://mypath_user:your_secure_pg_password@pg-service-host.upcloud.com:5432/mypath?sslmode=require

# --- Managed Redis on UpCloud ------------------------------------------------
# Replace with your UpCloud Managed Redis connection string (TLS rediss://)
REDIS_URL=rediss://default:your_secure_redis_password@redis-service-host.upcloud.com:6379

# --- Session & Security -------------------------------------------------------
# A strong random string (e.g., generated via: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_long_random_production_secret_string

# Frontend URL (for CORS allowlist in backend)
FRONTEND_URL=https://mypath.com

# Cookie domain: allows the session cookie to be shared between mypath.com and api.mypath.com
COOKIE_DOMAIN=.mypath.com

# --- Seeded Admin Account ----------------------------------------------------
# Used once by `npm run seed` to bootstrap the administrator account.
SEED_ADMIN_EMAIL=admin@domner.edu.kh
SEED_ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# --- Frontend Build & Runtime ------------------------------------------------
# Used by Next.js to direct browser API requests to your backend
NEXT_PUBLIC_API_URL=https://api.mypath.com

# --- Optional: Google OAuth --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.mypath.com/auth/google/callback

# --- Optional: Telegram Alerts for Verification Requests --------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
