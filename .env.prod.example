# ==============================================================================
# MyPath All-in-One Testing Configuration
# Copy this file to .env.prod on your server:
#   cp .env.prod.example .env.prod
# ==============================================================================

# --- 1. Your Domains (Replace with your registered domain) --------------------
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com

# --- 2. Application URLs ------------------------------------------------------
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com

# --- 3. Database (Self-hosted inside Docker) ----------------------------------
POSTGRES_USER=mypath
POSTGRES_PASSWORD=my_secure_db_password
POSTGRES_DB=mypath
DATABASE_URL=postgres://mypath:my_secure_db_password@db:5432/mypath

# --- 4. Session & Security ----------------------------------------------------
SESSION_SECRET=my_long_random_production_secret_key_12345

# --- 5. Initial Administrator (Created on first seed) -------------------------
SEED_ADMIN_EMAIL=admin@domner.edu.kh
SEED_ADMIN_PASSWORD=admin123456

# --- 6. Optional: Google OAuth ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback
