# Copy to .env at the repo root — Docker Compose reads it automatically.
#   cp .env.example .env
# Every value below has a working dev default in docker-compose.dev.yml,
# so an empty .env still boots. Override what you need.
# After editing .env, recreate the containers so they pick it up:
#   docker compose -f docker-compose.dev.yml up -d

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=mypath
POSTGRES_PASSWORD=mypath_dev_password
POSTGRES_DB=mypath
# Host port for the db. Change if 5432 is already taken by a local Postgres.
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------------------
# Use a long random string in any non-local environment.
SESSION_SECRET=mypath-dev-secret
FRONTEND_URL=http://localhost:3000

# --- Seeded admin account -------------------------------------------------
# `npm run seed` creates this admin if the email isn't registered yet.
# Registration can never create an admin, so this is how you get one.
# Changing the password here later does NOT update an existing account.
# Use a real password before the app is reachable from anywhere but localhost.
SEED_ADMIN_EMAIL=admin@domner.edu.kh
SEED_ADMIN_PASSWORD=admin123

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Optional: Telegram alerts -------------------------------------------
# When a student asks "is this scholarship real?", the review team gets a
# message in a Telegram group. Leave blank to rely on the admin queue alone
# (/admin/requests) — submissions are saved either way.
#   1. Create a bot with @BotFather and paste its token below.
#   2. Add the bot to the team group and send any message in the group.
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the
#      "chat":{"id": ...} value. Group ids are negative, e.g. -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: Google OAuth ----------------------------------------------
# Leave blank to run without Google sign-in (the backend logs a warning
# and /auth/google returns 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- Optional: Google Safe Browsing --------------------------------------
# Not read by any running code yet. Reserved for the planned live re-check
# of submitted links; the current checks are offline heuristics.
SAFE_BROWSING_API_KEY=
